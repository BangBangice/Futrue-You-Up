# Copy to .env and fill in. Never commit .env: this repository is public.
PERPLEXITY_API_KEY=
# Any model from https://api.perplexity.ai/v1/models. gpt-6-luna answers in about 2 s and costs about a tenth of a cent per reply.
PERPLEXITY_MODEL=openai/gpt-6-luna
# LLM=stub runs with scripted replies and no network
LLM=live
PORT=5183
# Set this only when hosting publicly (e.g. Railway): gates the whole app behind
# HTTP Basic Auth (any username, this as the password) instead of the localhost-only check.
APP_PASSWORD=
# Or set PUBLIC_ACCESS=1 to let anyone in with no login at all. Takes priority over APP_PASSWORD.
PUBLIC_ACCESS=
# Optional for now. The Postgres from `docker compose up db` is postgres://larp:larp@localhost:5432/larp
DATABASE_URL=
# Accounts (Better Auth) are on only when DATABASE_URL is set; then they replace APP_PASSWORD and PUBLIC_ACCESS.
# Signs session cookies and JWTs. Required in production: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The URL the browser uses to reach this server, e.g. https://larp.owsome.org. Its origin is the one allowed to sign in.
BETTER_AUTH_URL=http://localhost:5183
# Email for confirming addresses and resetting passwords. Resend in production; locally Mailpit
# (`docker compose up mailpit`, http://localhost:8025); with neither, links are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=LARP <no-reply@larp.owsome.org>
MAILPIT_URL=
# "Continue with Google" appears when both are set. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
