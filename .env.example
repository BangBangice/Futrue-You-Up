# Copy to .env and fill in. Never commit .env: this repository is public.
# A key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any model from https://api.openai.com/v1/models. gpt-6-luna answers in about 2 s and costs about a tenth of a cent per reply.
OPENAI_MODEL=gpt-6-luna
# LLM=stub runs with scripted replies and no network
LLM=live
PORT=5183
# Set this only when hosting publicly (e.g. Railway): gates the whole app behind
# HTTP Basic Auth (any username, this as the password) instead of the localhost-only check.
APP_PASSWORD=
# Or set PUBLIC_ACCESS=1 to let anyone in with no login at all. Takes priority over APP_PASSWORD.
PUBLIC_ACCESS=
# Optional for now. The Postgres from `docker compose up db` is postgres://larp:larp@localhost:5432/larp
DATABASE_URL=
# Accounts (Better Auth) are on only when DATABASE_URL is set; then they replace APP_PASSWORD and PUBLIC_ACCESS.
# Signs session cookies and JWTs. Required in production: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The URL the browser uses to reach this server, e.g. https://larp.owsome.org. Its origin is the one allowed to sign in.
BETTER_AUTH_URL=http://localhost:5183
# Email for confirming addresses and resetting passwords. Resend in production; locally Mailpit
# (`docker compose up mailpit`, http://localhost:8025); with neither, links are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=LARP <no-reply@larp.owsome.org>
MAILPIT_URL=
# "Continue with Google" appears when both are set. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Runs players' code in E2B cloud sandboxes (https://e2b.dev). Set it on the hosted server only;
# leave it empty locally and code runs in a local process instead. SANDBOX=local forces that even with a key.
# Git and the files stay on this server either way; only running code moves. `npm run check:e2b` tries it live.
E2B_API_KEY=
SANDBOX=
# Where files attached from the player's own computer are kept: `disk` (default) is .data/uploads, on the same volume
# as the shifts. `s3` puts the bytes in any S3-compatible bucket instead, which is what a host needs: Railway's
# filesystem is thrown away on every deploy. On Railway the bucket's own variables are read as they are — BUCKET,
# ACCESS_KEY_ID, SECRET_ACCESS_KEY, ENDPOINT and REGION — so referencing them onto the service is enough.
STORAGE=disk
# For `docker compose --profile s3 up`, which runs a bucket on http://localhost:9000 (console on :9001) and makes the
# bucket below: set STORAGE=s3 and uncomment the endpoint. Running the server inside Docker too, leave the endpoint out
# — compose points the app at http://minio:9000 itself.
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=larp
# S3_ACCESS_KEY_ID=larp
# S3_SECRET_ACCESS_KEY=larp-secret
# Region, for a bucket that cares. Railway's is in REGION; anything that does not care takes the default.
# S3_REGION=
# 1 for a bucket addressed as <bucket>.<endpoint> rather than <endpoint>/<bucket>. MinIO and Railway both answer path
# style, the default, so this is only for something that insists.
# S3_VIRTUAL_HOST=
# The largest single attached file, in bytes. Default 5242880 (5 MB).
# UPLOAD_MAX_BYTES=
